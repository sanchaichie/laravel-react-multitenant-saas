# Where the Laravel API listens. Read on the server only (no NEXT_PUBLIC_ prefix):
# the browser never calls the API directly, it goes through this app's /api proxy.
API_BASE_URL=http://localhost:8100

# The header your reverse proxy (nginx, a load balancer, Vercel) puts the browser's IP in,
# e.g. x-real-ip, or x-forwarded-for (its last entry is used). It's passed to Laravel,
# which trusts it only from this server (TRUSTED_PROXIES in api/.env). Leave empty when
# nothing sits in front of Next.js (locally): a client could otherwise choose its own IP.
CLIENT_IP_HEADER=
