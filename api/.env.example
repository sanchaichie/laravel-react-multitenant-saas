APP_NAME="React SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

# Origin of the React app (web/); the only origin allowed by CORS (config/cors.php)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Parallel requests for `php artisan serve` (needs --no-reload), so one slow request doesn't block the others.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=react_saas
DB_USERNAME=postgres
DB_PASSWORD=
# Don't set this here. The destructive migrate commands and db:wipe refuse to run on a
# non-test database; for one deliberate run: DB_ALLOW_DESTRUCTIVE_COMMANDS=true php artisan ...
# DB_ALLOW_DESTRUCTIVE_COMMANDS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails (verification, password reset, invitations, email-changed notices)
# to storage/logs/laravel.log; use smtp etc. in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@react-saas.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Days to keep audit log entries (deleted daily by model:prune); 0 keeps them forever.
AUDIT_RETENTION_DAYS=365

# Platform admin routes (/api/admin/*) need a token that passed a two-factor code within
# this many minutes (12 hours). Admins are made with `php artisan admin:grant {email}`.
ADMIN_TWO_FACTOR_TTL_MINUTES=720
# Admin actions (reset two-factor, sign out, suspend, make Owner) need a code within this many minutes.
ADMIN_ACTION_TWO_FACTOR_TTL_MINUTES=15
# A platform admin's read-only "view as user" session ends after this many minutes (not renewed).
ADMIN_IMPERSONATION_MINUTES=30

# AI (app/Ai). "anthropic" calls the Claude API with ANTHROPIC_API_KEY; "fake"
# returns canned answers with no network (local and e2e runs without a key).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Seconds per AI call; keep it below the job timeout (75s).
AI_TIMEOUT=60
# Server-side refusal fallback: empty (off), or "default" with Opus/Sonnet models.
AI_FALLBACKS=
# AI requests and calls per organization per minute.
AI_RATE_LIMIT_PER_MINUTE=5
# Monthly AI budget in USD of the Free plan, per organization (UTC month). Owners can
# set a lower one on the AI usage page; 0 turns AI off. Blank means 5.
AI_MONTHLY_BUDGET_USD=5
# Seconds for a whole streamed AI answer (writing help); each one holds a PHP worker.
AI_STREAM_TIMEOUT=120
# AI_PROVIDER=fake only: milliseconds between streamed pieces (e2e runs use 60 to watch them arrive).
AI_FAKE_STREAM_DELAY_MS=0
# Streamed AI answers running at once on the whole server; keep it below the PHP workers.
AI_MAX_CONCURRENT_STREAMS=3

# Billing (app/Billing, Laravel Cashier). "stripe" uses the keys below; "fake" makes
# no network calls (tests and e2e runs; only with APP_ENV=local or testing).
BILLING_PROVIDER=stripe
# From the Stripe dashboard (Developers > API keys); test-mode keys for local runs.
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret of the webhook endpoint (POST /api/stripe/webhook), or the one
# `stripe listen` prints. Without it every webhook is refused.
STRIPE_WEBHOOK_SECRET=
# Recurring price of the Pro plan (price_...). Without it, Pro can't be bought.
STRIPE_PRICE_PRO=
# Shown on the billing page only; Stripe charges the price's own amount.
BILLING_PRO_DISPLAY_PRICE="$19 / month"
# Pro's monthly AI budget in USD: the most a Pro organization can set.
BILLING_PRO_AI_BUDGET_USD=50
# One-time price of the $10 AI credit pack (price_...). Without it, credits can't be bought.
STRIPE_PRICE_CREDITS_10=
BILLING_CREDITS_10_DISPLAY_PRICE="$10"
# BILLING_PROVIDER=fake only: a checkout also does what the webhook would after a
# payment (Pro, or the credits). The e2e servers turn it on; leave it off elsewhere.
BILLING_FAKE_COMPLETE_CHECKOUT=false
